{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/brand-applications/**",
              "ui_kits/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:BioRhyme|Autography|Helvetica Brand|Helvetica Rounded Brand|Helvetica Compressed Brand))/i]",
        "message": "Font not provided by the design system. Available: BioRhyme, Autography, Helvetica Brand, Helvetica Rounded Brand, Helvetica Compressed Brand."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|full|iconLeft|iconRight|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, full, iconLeft, iconRight, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|ghost|onDeep)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'ghost' | 'onDeep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|padding|bordered|elevation|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: surface, padding, bordered, elevation, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:cream|paper|navy|blue|rose|peach)$/]",
        "message": "<Card> surface must be one of 'cream' | 'paper' | 'navy' | 'blue' | 'rose' | 'peach'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:none|rest|card|raised)$/]",
        "message": "<Card> elevation must be one of 'none' | 'rest' | 'card' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|disabled|tone|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, disabled, tone, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|deep)$/]",
        "message": "<Checkbox> tone must be one of 'light' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConceptIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:concept|size|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<ConceptIcon> doesn't accept that prop. Declared props: concept, size, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConceptIcon'] > JSXAttribute[name.name='concept'] > Literal[value!=/^(?:sunao|makoto|nagare|ikigai|enso)$/]",
        "message": "<ConceptIcon> concept must be one of 'sunao' | 'makoto' | 'nagare' | 'ikigai' | 'enso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConceptRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:concept|name|meaning|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<ConceptRow> doesn't accept that prop. Declared props: concept, name, meaning, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConceptRow'] > JSXAttribute[name.name='concept'] > Literal[value!=/^(?:sunao|makoto|nagare|ikigai|enso)$/]",
        "message": "<ConceptRow> concept must be one of 'sunao' | 'makoto' | 'nagare' | 'ikigai' | 'enso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConceptRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|deep)$/]",
        "message": "<ConceptRow> tone must be one of 'light' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnsoField'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|opacity|position|crop|assetBase|children|style|key|ref|className|style|children)$/]",
        "message": "<EnsoField> doesn't accept that prop. Declared props: size, opacity, position, crop, assetBase, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnsoField'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:right|left|center|bottom)$/]",
        "message": "<EnsoField> position must be one of 'right' | 'left' | 'center' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|type|multiline|rows|tone|placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, type, multiline, rows, tone, placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|deep)$/]",
        "message": "<Input> tone must be one of 'light' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|height|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, height, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:horizontal|stacked|signature)$/]",
        "message": "<Logo> variant must be one of 'horizontal' | 'stacked' | 'signature'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|cream)$/]",
        "message": "<Logo> tone must be one of 'blue' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PairList'] > JSXAttribute > JSXIdentifier[name!=/^(?:pairs|style|key|ref|className|style|children)$/]",
        "message": "<PairList> doesn't accept that prop. Declared props: pairs, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, attribution, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|strong|blue|rose)$/]",
        "message": "<Quote> tone must be one of 'cream' | 'strong' | 'blue' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|coral|cream|blue)$/]",
        "message": "<SectionLabel> tone must be one of 'accent' | 'coral' | 'cream' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|tone|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, tone, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|deep)$/]",
        "message": "<Select> tone must be one of 'light' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:concept|kicker|title|description|surface|footer|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: concept, kicker, title, description, surface, footer, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute[name.name='concept'] > Literal[value!=/^(?:sunao|makoto|nagare|ikigai|enso)$/]",
        "message": "<ServiceCard> concept must be one of 'sunao' | 'makoto' | 'nagare' | 'ikigai' | 'enso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:cream|paper|navy|blue|rose)$/]",
        "message": "<ServiceCard> surface must be one of 'cream' | 'paper' | 'navy' | 'blue' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Signature'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Signature> doesn't accept that prop. Declared props: children, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Signature'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|blue|navy|rose)$/]",
        "message": "<Signature> tone must be one of 'cream' | 'blue' | 'navy' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|emphasis|size|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<Statement> doesn't accept that prop. Declared props: children, emphasis, size, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Statement> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:strong|cream|blue|rose)$/]",
        "message": "<Statement> tone must be one of 'strong' | 'cream' | 'blue' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Statement> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|rose|peach|onDeep)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'rose' | 'peach' | 'onDeep'."
      }
    ]
  },
